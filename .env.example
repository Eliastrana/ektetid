# Copy to .env and fill in from your Supabase project:
# Project Settings -> Data API (URL) and API Keys (anon / publishable key).
#
# Both are safe to ship in the app binary — the anon key grants no access on its
# own, since every table is guarded by Row-Level Security.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
